# Newt/Pangolin client configuration for Sr. Kiwel's homelab
PANGOLIN_ENDPOINT=https://pangolin.kiwel.uk/
NEWT_NAME=jarvis-racknerd-vps
LOG_LEVEL=INFO

# Fill exactly one credential option before starting newt.service.

# Option A: existing Pangolin site credentials
# NEWT_ID=replace_with_site_id
# NEWT_SECRET=replace_with_site_credential

# Option B: one-time provisioning key
# NEWT_PROVISIONING_KEY=replace_with_provisioning_key
